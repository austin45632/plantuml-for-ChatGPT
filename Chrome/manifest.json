{
  "manifest_version": 3,
  "name": "PlantUML for ChatGPT",
  "version": "0.4.0",
  "description": "Renders PlantUML code blocks directly in ChatGPT conversations using a local PlantUML engine.",
  "author": "Arnaud Roques",
  "homepage_url": "https://github.com/plantuml/plantuml",


  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "renderer.html",
        "renderer.js",
        "viewer.html",
        "viewer.js",
        "vendor/plantuml.js",
        "adaml.min.js",
        "archimate.min.js",
        "azure.min.js",
        "c4.min.js",
        "classy-c4.min.js",
        "classy.min.js",
        "cloudinsight.min.js",
        "cloudogu.min.js",
        "domainstory.min.js",
        "edgy.min.js",
        "eip.min.js",
        "elastic.min.js",
        "gcp.min.js",
        "k8s.min.js",
        "kubernetes.min.js",
        "osa2.min.js"
      ],
      "matches": ["https://chatgpt.com/*"]
    }
  ],

  "permissions": ["clipboardWrite"]
}
